{
  "slug": "application_cost_daily",
  "name": "Application Cost Daily",
  "description": "One row per application per day: total USD, split by the application's scopes (any type) and services, breakdown by category and cloud service, and every resource behind it under its scope or service (with the rule that attributed it). Written by the allocator.",
  "schema": {
    "type": "object",
    "required": [
      "id",
      "day",
      "application_id",
      "total_usd",
      "computed_at"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "<application_id>-<day>",
        "alias": "id",
        "primaryKey": true,
        "autoGenerate": false
      },
      "day": {
        "type": "string",
        "description": "YYYY-MM-DD (UTC)",
        "index": [
          "filter"
        ]
      },
      "date": {
        "type": "string",
        "description": "Same as day"
      },
      "application_id": {
        "type": "string",
        "description": "null application id",
        "index": [
          "filter"
        ]
      },
      "application_slug": {
        "type": [
          "string",
          "null"
        ],
        "description": "null application slug"
      },
      "namespace_id": {
        "type": [
          "string",
          "null"
        ],
        "description": "null namespace id",
        "index": [
          "filter"
        ]
      },
      "account_id": {
        "type": [
          "string",
          "null"
        ],
        "description": "null account id",
        "index": [
          "filter"
        ]
      },
      "total_usd": {
        "type": "number",
        "description": "Total attributed to the application on the day (amortized)"
      },
      "by_category": {
        "type": "object",
        "description": "category \u2192 USD (compute, kubernetes, database, storage, network, observability, messaging, security, cdn, other)",
        "additionalProperties": {
          "type": "number"
        }
      },
      "by_cloud_service": {
        "type": "object",
        "description": "cloud service \u2192 USD",
        "additionalProperties": {
          "type": "number"
        }
      },
      "cloud_accounts": {
        "type": "array",
        "description": "Cloud accounts the cost came from",
        "items": {
          "type": "string"
        }
      },
      "currency": {
        "type": "string",
        "description": "USD"
      },
      "allocator": {
        "type": "string",
        "description": "finops_allocate_daily@<version>"
      },
      "computed_at": {
        "type": "string",
        "description": "ISO timestamp"
      },
      "scopes_usd": {
        "type": "number",
        "description": "\u03a3 cost attributed through the application's SCOPES (any type: k8s, lambda, custom/EC2, \u2026)"
      },
      "services_usd": {
        "type": "number",
        "description": "\u03a3 cost attributed through the application's SERVICES (databases, caches, \u2026)"
      },
      "application_usd": {
        "type": "number",
        "description": "Cost attributed to the application without a scope or service (e.g. by application tag)"
      },
      "scopes": {
        "type": "array",
        "description": "[{scope_id, scope_name, scope_type, cost_usd, by_category, consumption?: {core_h_chargeable, gb_h_chargeable, core_h_used, gb_h_used, usage_usd, waste_usd}, items: [{subject_type, subject_id, subject_name, cloud_service, category, cost_usd, share, allocation_method, rule_id, cluster, component}]}]",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "services": {
        "type": "array",
        "description": "[{service_id, service_name, cost_usd, by_category, items: [...]}]",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "application_items": {
        "type": "array",
        "description": "Items attributed directly to the application (no scope/service): same item shape",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "consumption": {
        "type": [
          "object",
          "null"
        ],
        "description": "\u03a3 over the application's k8s scopes: {core_h_chargeable, gb_h_chargeable, core_h_used, gb_h_used, usage_usd, waste_usd, scopes}",
        "additionalProperties": true
      },
      "items_count": {
        "type": "integer",
        "description": "How many allocated facts were rolled up"
      }
    }
  },
  "authorization": {
    "entities": {
      "grants": [
        {
          "actions": [
            "read",
            "list",
            "create",
            "write",
            "delete"
          ],
