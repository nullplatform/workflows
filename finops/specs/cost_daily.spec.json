      "gb_h_requested": {
        "type": [
          "number",
          "null"
        ],
        "description": "Kubernetes: memory GiB-hours requested"
      },
      "pods_avg": {
        "type": [
          "number",
          "null"
        ],
        "description": "Kubernetes: average pods over the day"
      },
      "k8s_overhead_usd": {
        "type": [
          "number",
          "null"
