        "additionalProperties": true
      },
      "host": {
        "type": [
          "string",
          "null"
        ],
        "description": "Primary endpoint/host of the subject (databases, caches) \u2014 evidence for mapping rules"
      },
      "category": {
        "type": [
          "string",
          "null"
