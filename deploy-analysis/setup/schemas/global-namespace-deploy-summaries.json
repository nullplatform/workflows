{
  "name": "Global Specification",
  "entity": "namespace",
  "description": "The deploy_summaries slice of the organization-wide namespace Global Specification. 04-global-namespace-spec.sh merges it in; every other category of that spec is left as it is.",
  "definition": {
    "type": "object",
    "additionalProperties": true,
    "visibleOn": [
      "list",
      "read"
    ],
    "properties": {
      "latest_short": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Highlights de la última semana (bullets cortos)",
        "visibleOn": [
          "list",
          "read"
        ]
      },
      "latest_summary": {
        "type": "string",
        "contentMediaType": "text/markdown",
        "description": "Resumen funcional de la última semana de deploys a producción",
        "visibleOn": [
          "list",
          "read"
        ]
      },
      "weeks": {
        "type": "array",
        "description": "Histórico semanal (rolling 53 semanas, más nuevo primero)",
        "visibleOn": [
          "read"
        ],
        "items": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "week_start": {
              "type": "string",
              "visibleOn": [
                "read",
                "list"
              ]
            },
            "week_end": {
              "type": "string",
              "visibleOn": []
            },
            "deploys": {
              "type": "integer",
              "visibleOn": [
                "read",
                "list"
              ]
            },
            "risk": {
              "type": "object",
              "additionalProperties": true,
              "visibleOn": [
                "read"
              ],
              "properties": {
                "low": {
                  "type": "integer",
                  "visibleOn": [
                    "read"
                  ]
                },
                "medium": {
                  "type": "integer",
                  "visibleOn": [
                    "read"
                  ]
                },
                "high": {
                  "type": "integer",
                  "visibleOn": [
                    "read"
                  ]
                },
                "unknown": {
                  "type": "integer",
                  "visibleOn": [
                    "read"
                  ]
                }
              }
            },
            "summary_md": {
              "type": "string",
              "visibleOn": [
                "read",
                "list"
              ],
              "contentMediaType": "text/markdown"
            },
            "prs": {
              "type": "integer",
              "visibleOn": [
                "read"
              ]
            },
            "contributors": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "github": {
                    "type": "string"
                  },
                  "roles": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "prs": {
                    "type": "integer"
                  }
                }
              },
              "visibleOn": [
                "read"
              ]
            },
            "generated_at": {
              "type": "string",
              "visibleOn": []
            }
          }
        }
      }
    }
  },
  "property": {
    "$ref": "#/definitions/deploy_summaries"
  },
  "category": {
    "type": "Category",
    "label": "Deploy summaries",
    "options": {
      "description": "Weekly functional summaries of production deploys across the namespace, written by the deploy-weekly-summary workflow."
    },
    "elements": [
      {
        "type": "Group",
        "label": "Latest week",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/deploy_summaries/properties/latest_short",
            "label": "Highlights"
          },
          {
            "type": "Control",
            "scope": "#/properties/deploy_summaries/properties/latest_summary",
            "label": "Summary"
          }
        ]
      },
      {
        "type": "Group",
        "label": "Weekly history",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/deploy_summaries/properties/weeks",
            "label": "Weeks",
            "options": {
              "layout": "table",
              "visibleColumns": [
                "week_start",
                "deploys"
              ],
              "detail": {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/summary_md",
                    "label": "Summary"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/risk",
                    "label": "Risk"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/prs",
                    "label": "PRs"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/contributors",
                    "label": "Contributors",
                    "options": {
                      "visibleColumns": [
                        "github",
                        "prs"
                      ]
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    ]
  }
}
